{
  "name": "puretv",
  "version": "0.1.0-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puremixai/puretv.git"
  },
  "homepage": "https://github.com/puremixai/puretv#readme",
  "bugs": {
    "url": "https://github.com/puremixai/puretv/issues"
  },
  "scripts": {
    "dev": "pnpm gen:manifest && node server.js",
    "build": "pnpm gen:manifest && next build --webpack",
    "build:cloudflare": "cross-env BUILD_TARGET=cloudflare pnpm gen:manifest && cross-env BUILD_TARGET=cloudflare node scripts/cloudflare-build.mjs",
    "start": "cross-env NODE_ENV=production node server.js",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "lint": "node scripts/lint-baseline.cjs",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "postbuild": "pnpm gen:pwa",
    "watch-room:server": "node server/watch-room-standalone-server.js --port 3001 --auth YOUR_SECRET_KEY",
    "init:sqlite": "node scripts/init-sqlite.js",
    "init:postgres": "node scripts/init-postgres.js",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.cjs",
    "test:postgres-redis": "node scripts/test-postgres-redis.cjs",
    "init:turso": "node scripts/init-turso.js",
    "db:reset": "node scripts/reset-sqlite.js",
    "build:edgeone": "pnpm edgeone:build",
    "preview:edgeone": "cross-env BUILD_TARGET=edgeone EDGEONE_PAGES=1 node scripts/edgeone-local-preview.mjs",
    "deploy:edgeone": "edgeone makers deploy .edgeone",
    "edgeone:login": "edgeone login",
    "edgeone:link": "edgeone makers link",
    "edgeone:build": "node scripts/edgeone-build.mjs",
    "deploy:edgeone:auto": "edgeone makers deploy",
    "check": "pnpm typecheck && pnpm lint && pnpm test --runInBand",
    "test:smoke": "node scripts/smoke-local.cjs",
    "test:smoke:production": "node scripts/smoke-local.cjs --production",
    "dev:turbo": "cross-env PURETV_BUNDLER=turbopack pnpm dev",
    "build:turbo": "pnpm gen:manifest && cross-env PURETV_BUNDLER=turbopack next build --turbopack && pnpm gen:pwa",
    "gen:pwa": "node scripts/generate-pwa.cjs",
    "lint:report": "eslint src",
    "lint:baseline": "node scripts/lint-baseline.cjs --update"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.15.0",
    "@next/env": "16.3.5",
    "@noble/hashes": "1.8.0",
    "@types/crypto-js": "^4.2.2",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.25.0",
    "@xmldom/xmldom": "^0.9.10",
    "anime4k-webgpu": "^1.0.0",
    "artplayer": "^5.4.0",
    "artplayer-plugin-danmuku": "^5.2.0",
    "artplayer-plugin-jassub": "1.1.0",
    "better-sqlite3": "^12.6.2",
    "bs58": "^6.0.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "edge-tts-universal": "^1.4.0",
    "flv.js": "^1.6.2",
    "framer-motion": "^12.18.1",
    "he": "^1.2.0",
    "hls.js": "^1.6.10",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.438.0",
    "mux.js": "^6.3.0",
    "nanoid": "^5.1.6",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.12",
    "nprogress": "^0.2.0",
    "opencc-js": "^1.0.5",
    "parse-torrent-name": "^0.5.4",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.4.0",
    "react-markdown": "^10.1.0",
    "redis": "^4.6.7",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swiper": "^11.2.8",
    "tailwind-merge": "^3.7.0",
    "xml2js": "^0.6.2",
    "xpath": "^0.0.34",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@opennextjs/cloudflare": "1.20.6",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bs58": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/node": "24.0.3",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "7.0.3",
    "edgeone": "^1.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "jest": "^30.5.1",
    "next-router-mock": "^0.9.0",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.8.3",
    "vercel": "^50.4.10",
    "webpack-obfuscator": "^3.5.1",
    "workbox-build": "7.4.1",
    "wrangler": "4.131.1",
    "jest-environment-jsdom": "^30.5.1"
  },
  "packageManager": "pnpm@10.14.0"
}
