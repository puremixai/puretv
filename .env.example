# Copy to .env.local and provide your own credentials before pnpm dev.
# Default site display name.
NEXT_PUBLIC_SITE_NAME=PureTV
# Node startup maps ADMIN_USERNAME to the legacy USERNAME variable (avoids Windows OS USERNAME).
ADMIN_USERNAME=admin
PASSWORD=
# Optional dedicated HMAC key. Changing it invalidates existing sessions.
AUTH_SECRET=
# d1 selects local SQLite on Node, and Cloudflare D1 in Cloudflare builds.
NEXT_PUBLIC_STORAGE_TYPE=d1
# PostgreSQL + Redis: set storage type to postgres; cache is configured separately.
# POSTGRES_URL=postgresql://puretv:password@postgres:5432/puretv
# POSTGRES_POOL_MAX=10
# CACHE_REDIS_URL=redis://:password@redis:6379/0
# CACHE_KEY_PREFIX=puretv:cache
HOSTNAME=127.0.0.1
PORT=3000
# SQLITE_DB_PATH defaults to <project>/.data/puretv.db.
# OFFLINE_DOWNLOAD_DIR should be an absolute writable path if offline download is enabled.

# Schedulers send Authorization: Bearer <CRON_SECRET> to /api/cron/run.
# Leaving this unset disables scheduled access.
CRON_SECRET=
# Optional server-only token for trusted media clients. Browser playback uses scoped tokens.
PROXY_M3U8_TOKEN=
# Additional administrator-trusted LAN origins, scoped to an existing live source key.
# LIVE_PROXY_TRUSTED_ORIGINS={"iptv":["http://192.168.1.20:8080"]}
# Server code execution is disabled by default and limited to the site owner.
ALLOW_SERVER_SCRIPTS=false
# Exact hostnames, comma separated; required for media proxying on edge platforms.
MEDIA_PROXY_ALLOWED_HOSTS=
## 全站弹幕获取总开关（false 时服务器与浏览器均停止获取弹幕）
DANMAKU_ENABLED=true

# Optional Go worker; all API adapters remain disabled by default.
# See services/go-worker/README.md before enabling offline downloads (single writer).
PURETV_GO_OFFLINE_DOWNLOADS=false
PURETV_GO_OPENLIST_SCAN=false
PURETV_GO_LOCAL_FILES=false
PURETV_GO_LIVE=false
PURETV_GO_NETDISK_CHECK=false
PURETV_GO_SEARCH=false
PURETV_GO_SUBSCRIPTIONS=false
PURETV_GO_ANIME_DOWNLOADS=false
PURETV_GO_DANMAKU=false
PURETV_GO_METADATA=false
PURETV_GO_TASKS=false
# Go process only; persistent task/receipt state, separate from downloads.
PURETV_GO_STATE_DIR=.data/worker
PURETV_GO_URL=http://127.0.0.1:8081
PURETV_GO_TOKEN=
