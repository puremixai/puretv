# Replace the domain and certificate paths before installing this file.
# The Nginx container must join PURETV_PROXY_NETWORK.
map $http_upgrade $puretv_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name tv.example.com;
    return 301 https://tv.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name tv.example.com;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/nginx/ssl/example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/example.com.key;
    client_max_body_size 100m;

    # Resolve Docker DNS again after application containers are recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $puretv_upstream http://puretv-web:3000;

    location / {
        proxy_pass $puretv_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $puretv_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 300s;
    }
}
